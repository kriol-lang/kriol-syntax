{
  "information_for_contributors": [
    "Generated from kriol-syntax.json by `npm run build` in kriol-syntax. Do not edit it by hand."
  ],
  "name": "kriol",
  "displayName": "Kriol",
  "aliases": [
    "kr"
  ],
  "scopeName": "source.kriol",
  "fileTypes": [
    "kriol",
    "kr"
  ],
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#types"
    },
    {
      "include": "#literals"
    },
    {
      "include": "#identifiers"
    },
    {
      "include": "#operators"
    }
  ],
  "repository": {
    "braces": {
      "comment": "Braces inside an interpolation, such as a molda literal, so its } does not end the interpolation.",
      "begin": "\\{",
      "end": "\\}",
      "patterns": [
        {
          "include": "#braces"
        },
        {
          "include": "$self"
        }
      ]
    },
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.kriol",
          "match": "//.*$"
        },
        {
          "name": "comment.block.kriol",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.kriol",
          "begin": "f?\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.kriol",
              "match": "\\\\."
            },
            {
              "name": "meta.interpolation.kriol",
              "begin": "\\{",
              "end": "\\}",
              "patterns": [
                {
                  "include": "#braces"
                },
                {
                  "include": "$self"
                }
              ]
            }
          ]
        },
        {
          "name": "string.quoted.single.kriol",
          "begin": "f?'",
          "end": "'",
          "patterns": [
            {
              "name": "constant.character.escape.kriol",
              "match": "\\\\."
            },
            {
              "name": "meta.interpolation.kriol",
              "begin": "\\{",
              "end": "\\}",
              "patterns": [
                {
                  "include": "#braces"
                },
                {
                  "include": "$self"
                }
              ]
            }
          ]
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.kriol",
          "match": "\\b(si|sinon|pa|nkuantu|kebra|kontinua|divolvi|tenta|lansa)\\b"
        },
        {
          "name": "keyword.other.kriol",
          "match": "\\b(fn|molda|inpristan)\\b"
        },
        {
          "name": "support.function.kriol",
          "match": "\\b(mostra|mostran|toma|sai|konfirma|paniku)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.kriol",
          "match": "\\b(num|int|bool|textu|i8|i16|i32|i64|u8|u16|u32|u64|f32|f64|isize|usize)\\b"
        },
        {
          "name": "support.type.kriol",
          "match": "\\b(Erru)\\b"
        },
        {
          "name": "entity.name.type.kriol",
          "match": "\\b[A-Z][A-Za-z0-9_]*\\b"
        },
        {
          "name": "constant.language.boolean.kriol",
          "match": "\\b(sin|nau)\\b"
        }
      ]
    },
    "literals": {
      "patterns": [
        {
          "name": "constant.numeric.float.kriol",
          "match": "(?<![A-Za-z0-9_])[+-]?[0-9]+\\.[0-9]+\\b"
        },
        {
          "name": "constant.numeric.integer.kriol",
          "match": "(?<![A-Za-z0-9_])[+-]?[0-9]+\\b"
        }
      ]
    },
    "identifiers": {
      "patterns": [
        {
          "name": "entity.name.function.kriol",
          "match": "\\b([a-zA-Z_][a-zA-Z0-9_]*)(?=\\s*\\()"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.kriol",
          "match": "::|\\+\\=|\\-\\=|\\*\\=|\\/\\=|%=|&=|\\|=|\\^=|==|!=|<=|>=|&&|\\|\\||[+\\-*/%<>=!:&|^~]"
        }
      ]
    }
  }
}
